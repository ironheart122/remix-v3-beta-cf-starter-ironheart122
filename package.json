{
  "name": "remix-v3-beta-cf-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import remix/node-tsx server.ts",
    "format": "prettier --write .",
    "lint": "oxlint --quiet",
    "lint:fix": "oxlint --fix --quiet",
    "prepare": "husky",
    "start": "node --import remix/node-tsx server.ts",
    "test": "node --import remix/node-tsx --test",
    "typecheck": "tsc --noEmit"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "package.json": "prettier --write"
  },
  "dependencies": {
    "remix": "3.0.0-beta.4"
  },
  "devDependencies": {
    "@types/node": "latest",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "oxlint": "^1.68.0",
    "prettier": "3.8.3",
    "prettier-plugin-packagejson": "^3.0.2",
    "typescript": "latest"
  },
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24.3.0"
  }
}
