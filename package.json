{
  "name": "remix-v3-beta-cf-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "dev": "vite dev",
    "format": "prettier --write .",
    "lint": "oxlint --quiet",
    "lint:fix": "oxlint --fix --quiet",
    "prepare": "husky",
    "preview": "vite build && vite preview",
    "test": "node --import remix/node-tsx --test",
    "typecheck": "tsc --noEmit"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "package.json": "prettier --write"
  },
  "dependencies": {
    "remix": "3.0.0-beta.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.40.0",
    "@types/node": "latest",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "oxlint": "^1.68.0",
    "prettier": "3.8.3",
    "prettier-plugin-packagejson": "^3.0.2",
    "typescript": "latest",
    "vite": "^7.3.5",
    "wrangler": "^4.98.0"
  },
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24.3.0"
  }
}
